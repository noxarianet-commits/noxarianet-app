# Public API base URL. Must include the /api suffix.
# Staging:
EXPO_PUBLIC_API_BASE_URL=https://staging.noxarianet.web.id/api

# Optional: link opened by the force-update screen (APK download page, WhatsApp, ...).
# EXPO_PUBLIC_UPDATE_URL=https://example.com/download

# Optional: override the support fallback when the backend has no WhatsApp CS number.
# EXPO_PUBLIC_SUPPORT_URL=https://wa.me/628xxxxxxxxxx

{
  "expo": {
    "name": "Noxarianet Store",
    "slug": "noxarianet-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "icon": "./assets/images/icon.png",
    "scheme": "noxarianet",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F1E9",
    "android": {
      "package": "com.noxarianet.store",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "adaptiveIcon": {
        "backgroundColor": "#F5F1E9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F1E9",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

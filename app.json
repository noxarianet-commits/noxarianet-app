{
  "expo": {
    "name": "Noxarianet Store",
    "slug": "noxarianet-store",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": ["android"],
    "icon": "./assets/images/icon.png",
    "scheme": "noxarianet",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F8F7FC",
    "android": {
      "package": "com.noxarianet.store",
      "versionCode": 1,
      "allowBackup": false,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#4D1B8C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4D1B8C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#4D1B8C",
          "defaultChannel": "noxarianet_transaksi"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "bfedbf3c-01c9-401b-a6d0-3093378a92f2"
      }
    }
  }
}
